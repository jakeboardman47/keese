# Copyright (c) {{YEAR}} {{ORG_NAME}}

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.{tf,hcl}]
indent_size = 2

[*.proto]
indent_size = 2
