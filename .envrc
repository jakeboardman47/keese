# direnv: auto-activate the Nix dev shell and load .env.local secrets.
# Run `direnv allow` once after cloning.

use flake

# Load .env.local if present. Never committed; see .env.local.example.
if [[ -f .env.local ]]; then
  dotenv .env.local
fi

# Example: confine Go tool caches inside the repo.
# export GOPATH="$PWD/.go"
# export GOBIN="$GOPATH/bin"
# export PATH="$GOBIN:$PATH"
