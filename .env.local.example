# Template for local secrets and environment overrides.
# Copy to `.env.local` (gitignored) and fill in. Never commit `.env.local`.
#
# Loaded automatically by `.envrc` (via direnv's dotenv support).

# ===== Worktree location override =====
# WORKTREE_BASE=/path/to/worktrees

# ===== API credentials (examples — add your own) =====
# MY_SERVICE_API_TOKEN=
# MY_SERVICE_API_URL=
