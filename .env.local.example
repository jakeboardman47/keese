#
# Local secrets + overrides. Never commit .env.local (gitignored).
# Copy this file to `.env.local` and fill in values.

# ===== Worktree location (used by scripts/agent-dispatch.sh) =====
# WORKTREE_BASE=/path/to/worktrees

# ===== Goose provider (default agent runtime; D8) =====
GOOSE_PROVIDER=anthropic                   # anthropic | openai | bedrock | ollama | databricks | google
GOOSE_MODEL=claude-opus-4-7
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# BEDROCK_AWS_REGION=
# BEDROCK_AWS_PROFILE=

# ===== OpenFGA (D4) — local dev store =====
OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=

# ===== OpenBao (D10) — local dev =====
BAO_ADDR=http://localhost:8200
BAO_TOKEN=

# ===== NATS JetStream (D6) =====
NATS_URL=nats://localhost:4222

# ===== Envoy AI Gateway (D5) — egress authz contract =====
EGRESS_GATEWAY_URL=http://localhost:10000
EGRESS_EXT_AUTHZ_CLUSTER=openfga-authz
EGRESS_SA_AUDIENCE_TEMPLATE=keese-egress-{TENANT}

# ===== OpenTelemetry (D11 / D17) =====
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=keese-operator
OTEL_SERVICE_VERSION=0.1.0-dev

# ===== Elasticsearch + APM (D17) =====
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=
APM_TOKEN=

# ===== Kind / Tilt =====
KIND_CLUSTER_NAME=keese-dev
TILT_HOST=127.0.0.1

# ===== Registries (tag-gated push targets; unset to skip push) =====
# IMG=ghcr.io/keese-ai/keese:dev
# BUNDLE_IMG=ghcr.io/keese-ai/keese-bundle:dev

# ===== Envtest =====
# KUBEBUILDER_ASSETS is exported by `make envtest-setup`; override here only if needed.
# KUBEBUILDER_ASSETS=

# ===== OpenTofu cloud (D18) =====
# TF_VAR_aws_region=us-west-2
# TF_VAR_gcp_project=keese-dev
# TF_VAR_azure_subscription_id=
# TF_VAR_cluster_name=keese
