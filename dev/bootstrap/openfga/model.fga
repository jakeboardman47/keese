#
# OpenFGA DSL authorization model for keese (schema 1.1).
# Loaded by the seed Job (seed.yaml) after store creation.
#
# Types map to keese entities defined in docs/designs/04a-openfga-authz-model.md.
# Every relation that a CRD field touches carries:
#   // +keese:rebac-tuple=<relation>   (rule 04.14)
#
# TODO(design-gate): tests/openfga/*.yaml positive + negative assertions
# must be authored before the design gate opens (per rebac-modeler instructions).

model
  schema 1.1

# Human operator, CI identity, or any K8s RBAC subject.
type user

# Per-workspace projected ServiceAccount.
# Audience form: keese-egress-<tenant>  (04b owns canonical form).
type service_account
  relations
    define member_of: [tenant]

# Capsule Tenant (capsule.clastix.io/v1beta2/Tenant). No keese Tenant CRD (D23).
type tenant
  relations
    define admin: [user]
    define member: [user, service_account] or admin
    define viewer: [user] or member

# Agent execution scope (workspace.operator.keese.ai/Workspace).
# Tuples survive pod churn (D24); deleted only on CR deletion via finalizer.
type workspace
  relations
    define owner: [tenant]
    define admin: [user] or admin from owner
    define editor: [user] or admin
    define viewer: [user] or editor
    define supervised_by: [witness]
    define can_run: editor
    define can_read_memory: viewer
    define can_write_memory: editor

# Cross-tenant access grant (workspace.operator.keese.ai/WorkspaceShare).
# Written after ReferenceGrant validation; requires grantee membership check.
type workspace_share
  relations
    define grantor: [workspace]
    define grantee: [tenant]
    define can_access: [service_account]

# Callable MCP function exposed by a RuntimeExtension.
# can_call is resolved in ext_authz as: allowed_in ∩ tenant member.
# (Intersection expressed at check time via contextual tuples or ext_authz logic
# because OpenFGA 1.1 does not support multi-type intersection natively.)
type tool
  relations
    define owner: [workspace]
    define allowed_in: [workspace]
    define can_call: [service_account, user]

# Upstream model allow/deny scope. Deny wins over allow.
# Check logic: allowed AND NOT denied (evaluated in ext_authz).
type model_gate
  relations
    define allows: [workspace]
    define denies: [workspace]

# Memory / SharedMemory backend (memory.operator.keese.ai).
# For SharedMemory, writer uses workspace-level reader grants.
type memory
  relations
    define owner: [workspace]
    define reader: [user, service_account, workspace] or can_read_memory from owner
    define writer: [user, service_account] or can_write_memory from owner
    define can_read: reader
    define can_write: writer

# Supervision agent (D23 — forward-compatible placeholder).
# Details and escalation ladder deferred to 23-agent-supervision.md.
# Witness SA is write-scoped to witness:* objects only.
type witness
  relations
    define can_read: [workspace]
