# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 keese-ai
#
# OpenFGA DSL authorization model for keese.
# Loaded by the seed Job (seed.yaml) after store creation.
#
# Types defined here map to the key entities in the system:
#   tenant          → top-level isolation boundary (keese.ai/v1alpha1/Tenant)
#   workspace       → agent execution scope (keese Workspace CR)
#   tool            → callable function/extension exposed to agents
#   extension       → RuntimeExtension provider (tool set)
#   credential      → BackendSecurityPolicy-referenced secret
#   memory          → Memory / SharedMemory CR backends
#   service_account → projected Kubernetes SA per workspace
#   user            → human operator or CI identity
#   witness         → supervision agent dispatched by agent-supervision controller (D23)
#
# Relations encode the ReBAC model described in docs/designs/04a-openfga-authz-model.md.
# Design 04a iter-2 status: current (2026-04-20).
#
# Key changes vs iter-1:
#   - workspace.tenant_member: computed relation (member from owner) replaces per-tuple member grants
#   - tool.can_call: uses tenant_member from allowed_in (single Check; not dual-Check)
#   - workspace.can_revoke: automation-only (witness, service_account); not for user subjects
#   - workspace.supervised_by: [witness] added
#   - witness type added
#
# 04a iter-5 (D29) additions for cross-tenant a2a messaging (2026-04-21):
#   - tenant.allows_messaging: [tenant] — directional bilateral grant, written by
#     CrossTenantAgreement controller (design 25) after both-side approval
#   - workspace.messageable_from: [workspace] — workspace-pair grant for fine-grained
#     cross-tenant a2a authz; ext_authz at NATS / a2a transport gates publish + subscribe
#
# 04a iter-6 (D28) additions for per-tenant OIDCProvider gating (2026-04-21):
#   - oidc_provider type: cluster-scoped; identity = OIDCProvider.metadata.name
#   - tenant.uses_oidc_provider: [oidc_provider] — written by Tenant controller per
#     Tenant.spec.oidc.allowedProviders[]; ext_authz checks before validating tokens
#     from any issuer for a given tenant
#
# 04a iter-7 (E2) additive change for synchronous A2A HTTP/SSE endpoint authz (2026-06-11):
#   - workspace.a2a_callable_by: [workspace] — inbound A2A endpoint grant, distinct from
#     messageable_from (NATS). Written by the Workspace controller on spec.a2a.enabled:
#     self tuple for intra-tenant; per-peer tuple gated by an Approved CrossTenantAgreement
#     for cross-tenant. ext_authz Checks workspace:W_to#a2a_callable_by@workspace:W_from.
#   ADDITIVE ONLY: no prior relation removed or altered; all iter-1..6 tuples stay valid.

model
  schema 1.1

type user

type service_account
  relations
    define member_of: [tenant]

type witness

type tenant
  relations
    define admin: [user]
    define member: [user, service_account] or admin
    # allows_messaging: directional, written by CrossTenantAgreement controller (D29)
    # after both-side approval. Tuple shape: tenant:T_to#allows_messaging@tenant:T_from.
    # Manual writes (out-of-band third-party authz) tolerated; controller no-ops on existing
    # tuple and emits OutOfBandTupleObserved. Intra-tenant a2a does NOT use this relation —
    # it is implicit via Workflow definition + NATS topic naming
    # (keese.tenant.<tenant-uid>.wf.<workflow-run-uid>.*).
    define allows_messaging: [tenant]
    # uses_oidc_provider: per-tenant OIDCProvider allow-list (D28 / 04a iter-6).
    # Tuple shape: tenant:T#uses_oidc_provider@oidc_provider:P. Written by the
    # Tenant controller for each entry in Tenant.spec.oidc.allowedProviders[].
    # ext_authz checks Check(tenant:T#uses_oidc_provider@oidc_provider:P) before
    # accepting tokens from issuer P for tenant T. Issuer not in allow-list → deny.
    # Cross-cut: authz.keese.ai/v1alpha1 spec §1.6, D26/D24 Tenant CRD.
    define uses_oidc_provider: [oidc_provider]

type workspace
  relations
    define owner: [tenant]
    define admin: [user] or admin from owner
    define editor: [user] or admin
    define viewer: [user] or editor
    define supervised_by: [witness]
    define can_run: editor
    define can_read_memory: viewer
    define can_write_memory: editor
    # tenant_member: propagates tenant.member down to this workspace via the owner tenant.
    # Used by tool.can_call to avoid per-workspace tuple explosion.
    define tenant_member: member from owner
    # can_revoke: automation-only. Written by:
    #   - operator install Job: workspace:*#can_revoke@service_account:keese-supervisor
    #   - supervision controller (D23): workspace:<name>#can_revoke@witness:<id>
    # NOT granted to user:* — humans use Workspace.spec.suspended for graceful suspension.
    define can_revoke: [witness, service_account]
    # messageable_from: workspace-pair grant for cross-tenant a2a messaging (D29 / 04a iter-5).
    # Tuple shape: workspace:W_to#messageable_from@workspace:W_from. Written by the
    # CrossTenantAgreement controller after bilateral approval, expanded as the
    # cartesian product of from.workspaceSelector × to.workspaceSelector. ext_authz at the
    # NATS / a2a transport (design 09) calls Check before subscribe + first publish.
    define messageable_from: [workspace]
    # a2a_callable_by: inbound A2A HTTP/SSE endpoint grant (E2 / 04a iter-7).
    # Tuple shape: workspace:W_to#a2a_callable_by@workspace:W_from. Distinct from
    # messageable_from (NATS publish/subscribe): a2a_callable_by gates the synchronous
    # A2A HTTP/SSE call into W_to's a2a-bridge endpoint (design 09 / E1b bridge).
    # Written by the Workspace controller (workspace_controller.go a2aTuplesFor) when
    # spec.a2a.enabled:
    #   - intra-tenant: self tuple workspace:W#a2a_callable_by@workspace:W; same-tenant
    #     peers are admitted by the self grant (the controller opens the endpoint).
    #   - cross-tenant: one tuple per peer workspace, written ONLY after an Approved
    #     CrossTenantAgreement (D25/D29) references both tenants. Absent a CTA no tuple is
    #     written and the ext_authz Check fails closed (rule 05.4).
    # ext_authz (internal/authz/extauth) calls
    # Check(user=workspace:W_from, relation=a2a_callable_by, object=workspace:W_to).
    define a2a_callable_by: [workspace]

type tool
  relations
    define owner: [extension]
    define allowed_in: [workspace]
    # can_call resolves via computed relation:
    #   tool → allowed_in → workspace → tenant_member → owner → tenant → member
    # Single Check(tool:X#can_call@service_account:SA) replaces dual-Check pattern.
    # Fallback: --openfga-check-mode=dual in ext_authz sidecar (incident mitigation only).
    define can_call: tenant_member from allowed_in

type extension
  relations
    define owner: [tenant]
    define enabled_in: [workspace]

type credential
  relations
    define owner: [tenant]
    define bound_to: [workspace]
    define can_use: [service_account] and bound_to

type memory
  relations
    define owner: [workspace]
    define reader: [user, service_account] or owner from owner
    define writer: [user, service_account] or owner from owner
    define can_read: reader
    define can_write: writer

# oidc_provider: cluster-scoped entity; identity = OIDCProvider.metadata.name.
# No relations defined on oidc_provider itself — it is a leaf type referenced
# only via tenant.uses_oidc_provider.  CRD: authz.keese.ai/v1alpha1/OIDCProvider (D28).
type oidc_provider

type session
  relations
    define attached_by: [user, service_account]
