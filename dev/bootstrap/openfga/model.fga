# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 keese-ai
#
# OpenFGA DSL authorization model for keese.
# Loaded by the seed Job (seed.yaml) after store creation.
#
# Types defined here map to the key entities in the system:
#   tenant          → top-level isolation boundary (tenancy.operator.keese.ai/v1alpha1/Tenant)
#   workspace       → agent execution scope (keese Workspace CR)
#   tool            → callable function/extension exposed to agents
#   extension       → RuntimeExtension provider (tool set)
#   credential      → BackendSecurityPolicy-referenced secret
#   memory          → Memory / SharedMemory CR backends
#   service_account → projected Kubernetes SA per workspace
#   user            → human operator or CI identity
#   witness         → supervision agent dispatched by agent-supervision controller (D23)
#
# Relations encode the ReBAC model described in docs/designs/04a-openfga-authz-model.md.
# Design 04a iter-2 status: current (2026-04-20).
#
# Key changes vs iter-1:
#   - workspace.tenant_member: computed relation (member from owner) replaces per-tuple member grants
#   - tool.can_call: uses tenant_member from allowed_in (single Check; not dual-Check)
#   - workspace.can_revoke: automation-only (witness, service_account); not for user subjects
#   - workspace.supervised_by: [witness] added
#   - witness type added

model
  schema 1.1

type user

type service_account
  relations
    define member_of: [tenant]

type witness

type tenant
  relations
    define admin: [user]
    define member: [user, service_account] or admin

type workspace
  relations
    define owner: [tenant]
    define admin: [user] or admin from owner
    define editor: [user] or admin
    define viewer: [user] or editor
    define supervised_by: [witness]
    define can_run: editor
    define can_read_memory: viewer
    define can_write_memory: editor
    # tenant_member: propagates tenant.member down to this workspace via the owner tenant.
    # Used by tool.can_call to avoid per-workspace tuple explosion.
    define tenant_member: member from owner
    # can_revoke: automation-only. Written by:
    #   - operator install Job: workspace:*#can_revoke@service_account:keese-supervisor
    #   - supervision controller (D23): workspace:<name>#can_revoke@witness:<id>
    # NOT granted to user:* — humans use Workspace.spec.suspended for graceful suspension.
    define can_revoke: [witness, service_account]

type tool
  relations
    define owner: [extension]
    define allowed_in: [workspace]
    # can_call resolves via computed relation:
    #   tool → allowed_in → workspace → tenant_member → owner → tenant → member
    # Single Check(tool:X#can_call@service_account:SA) replaces dual-Check pattern.
    # Fallback: --openfga-check-mode=dual in ext_authz sidecar (incident mitigation only).
    define can_call: tenant_member from allowed_in

type extension
  relations
    define owner: [tenant]
    define enabled_in: [workspace]

type credential
  relations
    define owner: [tenant]
    define bound_to: [workspace]
    define can_use: [service_account] and bound_to

type memory
  relations
    define owner: [workspace]
    define reader: [user, service_account] or owner from owner
    define writer: [user, service_account] or owner from owner
    define can_read: reader
    define can_write: writer
