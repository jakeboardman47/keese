{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Edit(**)",
      "Write(**)",
      "Bash(make *)",
      "Bash(pre-commit *)",
      "Bash(shfmt *)",
      "Bash(shellcheck *)",
      "Bash(markdownlint *)",
      "Bash(lychee *)",
      "Bash(yq *)",
      "Bash(jq *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git worktree list*)",
      "Bash(git worktree add*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git config --get*)",
      "Bash(tree *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdocs *)",
      "Bash(detect-secrets *)",
      "Bash(gitleaks *)",
      "Bash(trivy *)",
      "Bash(scripts/*)",

      "Bash(operator-sdk *)",
      "Bash(controller-gen *)",
      "Bash(setup-envtest *)",
      "Bash(kustomize *)",
      "Bash(kubectl --dry-run=* *)",
      "Bash(kubectl --context=kind-keese* *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl explain *)",
      "Bash(kubectl version*)",
      "Bash(kubectl config get-contexts*)",
      "Bash(kubectl config current-context*)",
      "Bash(kind get *)",
      "Bash(kind create cluster --name=keese*)",
      "Bash(kind delete cluster --name=keese*)",
      "Bash(ctlptl apply *)",
      "Bash(ctlptl get *)",
      "Bash(tilt up --context=kind-keese*)",
      "Bash(tilt down --context=kind-keese*)",
      "Bash(helm template *)",
      "Bash(helm lint *)",
      "Bash(helm upgrade --install --dry-run*)",
      "Bash(helmfile lint *)",
      "Bash(helmfile diff *)",
      "Bash(helmfile template *)",
      "Bash(kubeconform *)",
      "Bash(pluto *)",
      "Bash(kuttl *)",
      "Bash(fga *)",
      "Bash(stern *)",
      "Bash(k9s *)",
      "Bash(gosec *)",
      "Bash(govulncheck *)",
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(gofumpt *)",
      "Bash(goimports *)",
      "Bash(golangci-lint *)",
      "Bash(tofu fmt *)",
      "Bash(tofu init *)",
      "Bash(tofu plan *)",
      "Bash(tofu validate *)",
      "Bash(conftest *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git reset*)",
      "Bash(git checkout main*)",
      "Bash(git worktree remove*)",
      "Bash(make release*)",
      "Bash(gh *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(kubectl patch *)",
      "Bash(docker build *)",
      "Bash(docker run *)",
      "Bash(operator-sdk run *)",
      "Bash(helmfile sync *)",
      "Bash(tofu apply *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard origin*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/kubeconfig)",
      "Read(**/kubeconfig-*)",

      "Bash(kubectl * --context=prod-*)",
      "Bash(kubectl * --context=*production*)",
      "Bash(kubectl * --context=*prd*)",
      "Bash(docker push*)",
      "Bash(helm install *)",
      "Bash(helm upgrade * --context=prod-*)",
      "Bash(operator-sdk run bundle * --index-image=*prod*)",
      "Read(dev/bootstrap/**/secrets/**)",
      "Bash(fga store delete*)",
      "Bash(kind delete clusters)",
      "Bash(tofu destroy *)",
      "Bash(tofu workspace delete *)",
      "Bash(tofu apply * --context=prod-*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-secret-read.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-conventional-commit.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce-spdx-header.sh"
          }
        ]
      }
    ]
  }
}
