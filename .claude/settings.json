{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Edit(**)",
      "Write(**)",
      "Bash(make *)",
      "Bash(pre-commit *)",
      "Bash(shfmt *)",
      "Bash(shellcheck *)",
      "Bash(markdownlint *)",
      "Bash(lychee *)",
      "Bash(yq *)",
      "Bash(jq *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git worktree list*)",
      "Bash(git worktree add*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse*)",
      "Bash(git config --get*)",
      "Bash(tree *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdocs *)",
      "Bash(detect-secrets *)",
      "Bash(gitleaks *)",
      "Bash(trivy *)",
      "Bash(scripts/*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git reset*)",
      "Bash(git checkout main*)",
      "Bash(git worktree remove*)",
      "Bash(make release*)",
      "Bash(gh *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard origin*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/kubeconfig)",
      "Read(**/kubeconfig-*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-secret-read.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-conventional-commit.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/enforce-spdx-header.sh"
          }
        ]
      }
    ]
  }
}
