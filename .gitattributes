# Default to LF line endings and text detection.
* text=auto eol=lf

# Generated / vendored files — keep stable in diffs.
vendor/** linguist-vendored
**/zz_generated_*.go linguist-generated
**/*.pb.go linguist-generated

# ===== Git LFS =====
# Large binary assets that should not bloat git history.
# Enable with: git lfs install && git lfs track '<pattern>' (or edit this file).
*.qcow2   filter=lfs diff=lfs merge=lfs -text
*.img     filter=lfs diff=lfs merge=lfs -text
*.iso     filter=lfs diff=lfs merge=lfs -text
*.vhdx    filter=lfs diff=lfs merge=lfs -text
*.tar.xz  filter=lfs diff=lfs merge=lfs -text
*.tar.gz  filter=lfs diff=lfs merge=lfs -text

# Media (only commit if a doc needs a diagram / screenshot).
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.pdf     binary

# Signing artifacts are binary and should not be diffed.
*.sig     binary
*.cert    binary

# Generated SBOMs are JSON but very large.
sbom-*.spdx.json  linguist-generated
